NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/carepoint

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# 32-byte key for field-level encryption, e.g. `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY=replace_with_32_byte_key

CLIENT_URL=http://localhost:5173

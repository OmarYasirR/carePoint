# ---- Dependencies ----
node_modules/
.npm/
.pnp
.pnp.js

# ---- Environment variables ----
# Real secrets never get committed — only the .env.example templates do.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# ---- Build output ----
dist/
build/
client/dist/
server/dist/
.vite/
.turbo/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---- Test / coverage ----
coverage/
.nyc_output/

# ---- User-uploaded files ----
# Local-disk multer storage (server/src/middleware/upload.js) — keep
# the folder in git via .gitkeep, but never the files patients/doctors
# actually upload.
server/uploads/*
!server/uploads/.gitkeep

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editors / IDEs ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- Misc ----
*.tsbuildinfo
.eslintcache
.cache/
tmp/
temp/